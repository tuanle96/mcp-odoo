{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.erpipe-org/mcp-odoo",
  "description": "Odoo MCP: gated writes, multi-instance. Free hosted: ERPipe (mcp.erpipe.com)",
  "version": "1.3.1",
  "websiteUrl": "https://erpipe-org.github.io/mcp-odoo/",
  "repository": {
    "url": "https://github.com/erpipe-org/mcp-odoo",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "odoo-mcp",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ODOO_URL",
          "description": "Odoo server URL, e.g. https://mycompany.odoo.com",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_DB",
          "description": "Odoo database name",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_USERNAME",
          "description": "Odoo login (email)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ODOO_PASSWORD",
          "description": "Odoo password or API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
